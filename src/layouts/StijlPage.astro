---
/**
 * StijlPage.astro — a plain page shell for author tools (the outline pages).
 * The site itself is the world (components/cosmos/WorldPage.astro).
 */
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;800&family=Barlow+Condensed:wght@500;600&family=Courier+Prime:wght@400;700&display=swap" />
  </head>
  <body data-type="workshop" class="m-0 bg-[var(--ill-paper)] text-[var(--ill-ink)]">
    <nav class="site-nav" aria-label="Author tools">
      <a class="an-key" href={base}>← The map</a>
      <a class="an-key" href={`${base}outline`}>Outlines</a>
    </nav>
    <slot />
    <style is:global>
      .site-nav { position: sticky; top: 0; z-index: 20; display: flex; flex-wrap: wrap; gap: 8px; padding: 12px clamp(16px, 4vw, 48px); background: var(--ill-paper); border-bottom: 6px solid var(--ill-ink); }
      .site-nav a { padding: 8px 14px; font-size: 14px; text-decoration: none; }
    </style>
  </body>
</html>
