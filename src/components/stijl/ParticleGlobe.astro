---
/**
 * ParticleGlobe.astro — a standalone "photo of the visit" stage
 * ---------------------------------------------------------------------------
 * Picks a photo (never the same one twice in a row per browser session),
 * shows it gathering out of a globe of its own pixels, and re-forms the globe
 * while the visitor holds it. The gallery lightbox uses the same module.
 *
 *   <ParticleGlobe photos={['/photos/japan/1.jpg', … ]} class="h-[80svh]" />
 *
 * Props: photos (URLs), label (accessible name), class (sizing; default fills its box)
 */
interface Props { photos: string[]; label?: string; class?: string }
const { photos, label = 'Hold to form a particle globe', class: className } = Astro.props;
---
<div class:list={['globe-stage', className]} data-photos={JSON.stringify(photos)}>
  <canvas role="button" tabindex="0" aria-label={label}></canvas>
  <noscript><img src={photos[0]} alt="" /></noscript>
</div>

<script>
  import { mountParticleGlobe, pickPhoto } from '../../lib/stijl/particle-globe.js';
  for (const stage of document.querySelectorAll<HTMLElement>('.globe-stage')) {
    const canvas = stage.querySelector('canvas')!;
    const photos = JSON.parse(stage.dataset.photos || '[]');
    const photo = pickPhoto(photos);
    mountParticleGlobe(canvas, { photo, settleDelay: 0.8 }).then((g) => {
      if (!g) stage.insertAdjacentHTML('beforeend', `<img src="${photo}" alt="" class="globe-stage__fallback">`);
    });
  }
</script>

<style>
  .globe-stage { position: relative; width: 100%; height: 100%; min-height: 60svh; background: var(--ill-paper, #eeeeea); outline: 12px solid var(--ill-ink, #000); outline-offset: -12px; }
  .globe-stage canvas { display: block; width: 100%; height: 100%; cursor: crosshair; touch-action: none; }
  .globe-stage canvas:focus-visible { outline: 4px solid var(--ill-red, #d40920); outline-offset: -16px; }
  .globe-stage__fallback { position: absolute; inset: 12px; width: calc(100% - 24px); height: calc(100% - 24px); object-fit: contain; }
</style>
