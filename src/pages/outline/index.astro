---
/** /outline — author tool: every project, and how its document was read into slides. */
import StijlPage from '../../layouts/StijlPage.astro';
import { getProjects } from '../../lib/site/content';
const projects = await getProjects();
const base = import.meta.env.BASE_URL;
---
<StijlPage title="Outlines">
  <main class="stijl-page">
    <div class="stijl-page__head">
      <h1 class="stijl-page__title">Outlines</h1>
      <p class="stijl-page__lede">How each project's document was read into slides: every block, and the rule that produced it.</p>
    </div>
    <ul class="outline-list">
      {projects.map((p) => (
        <li><a class="an-key" style="display:inline-block;padding:10px 16px;margin:4px 0;text-decoration:none" href={`${base}outline/${p.slug}`}>{p.title}</a> <span>{p.slides.length} slides · {p.source === 'document' ? 'from the document' : 'built by hand'}</span></li>
      ))}
    </ul>
  </main>
</StijlPage>
