---
/**
 * /lab/illusions — the editor's playground.
 * ---------------------------------------------------------------------------
 * Renders the published illusion settings with the admin panel attached.
 * The panel is only included in development builds; in production this
 * page shows exactly what the CMS publishes.
 *
 * OPTION: delete this page and drop <IllusionStage> into your home page's
 * hero instead; keep the IllusionAdmin line guarded by import.meta.env.DEV.
 */
import IllusionStage from '../../components/illusion/IllusionStage.astro';
import IllusionAdmin from '../../components/illusion/IllusionAdmin.astro';
import { getIllusionConfig } from '../../lib/illusion/content';
import '../../styles/global.css'; // your existing stylesheet that imports tailwindcss + illusion.tailwind.css

const illusion = await getIllusionConfig();
const isEditor = import.meta.env.DEV;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Illusion lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;800&family=Barlow+Condensed:wght@500;600&family=Courier+Prime:wght@400;700&family=Special+Elite&family=Big+Shoulders+Display:wght@800;900&family=Instrument+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body class="m-0 bg-stijl-ink">
    <IllusionStage id="lab-stage" config={illusion} persist={isEditor} />
    {isEditor && <IllusionAdmin target="lab-stage" />}
  </body>
</html>
